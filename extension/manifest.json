{
  "manifest_version": 3,
  "name": "Get MP3",
  "version": "1.0.0",
  "description": "유튜브 영상을 MP3로 저장",
  "permissions": ["downloads", "storage"],
  "host_permissions": [
    "http://localhost:38472/*",
    "http://127.0.0.1:38472/*",
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/watch*", "*://youtube.com/watch*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/mp3-16.png",
      "24": "icons/mp3-24.png",
      "48": "icons/mp3-24.png",
      "128": "icons/mp3-24.png"
    }
  },
  "icons": {
    "16": "icons/mp3-16.png",
    "48": "icons/mp3-24.png",
    "128": "icons/mp3-24.png"
  }
}
